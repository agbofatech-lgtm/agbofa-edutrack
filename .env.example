# Copy to .env for local development. Never put real secrets in this tracked template.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Local-only PostgreSQL service values. Set POSTGRES_PASSWORD to a generated random value.
POSTGRES_DB=edutrack_local
POSTGRES_USER=edutrack_local
POSTGRES_PASSWORD=
DATABASE_URL=

# Local-only Redis. Configure authentication/TLS and a private endpoint for any shared environment.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
