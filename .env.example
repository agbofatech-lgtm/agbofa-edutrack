# Copy to .env for local development. Never put real secrets in this tracked template.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
MFA_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Recovery delivery stays disabled until an Owner approves and configures an adapter.
IDENTITY_RECOVERY_DELIVERY_BACKEND=
IDENTITY_RECOVERY_TOKEN_TTL_SECONDS=0
IDENTITY_MFA_SETUP_TTL_SECONDS=300
IDENTITY_LOGIN_RATE_LIMIT=10/min
IDENTITY_MFA_RATE_LIMIT=10/min
IDENTITY_RECOVERY_RATE_LIMIT=5/hour

# Phase 04 governance gates. Keep empty until Owner approves the exact
# institution-level JHS Contact Person/Headmaster role mappings and Basic 9 code.
# A permission code or staff affiliation alone never grants mock authority.
ACADEMIC_MOCK_PREPARER_ROLE_CODE=
ACADEMIC_MOCK_APPROVER_ROLE_CODE=
ACADEMIC_BECE_LEVEL_CODE=

# Local-only PostgreSQL service values. Set POSTGRES_PASSWORD to a generated random value.
POSTGRES_DB=edutrack_local
POSTGRES_USER=edutrack_local
POSTGRES_PASSWORD=
DATABASE_URL=

# Local-only Redis. Configure authentication/TLS and a private endpoint for any shared environment.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
